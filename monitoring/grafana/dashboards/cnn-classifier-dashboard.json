{
  "title": "Chest CT-Scan Classifier - API & Model Monitoring",
  "uid": "cnn-classifier",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by endpoint",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (path) (rate(http_requests_total[1m]))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate (4xx/5xx)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_code=~\"4..|5..\"}[1m]))",
          "legendFormat": "errors/sec"
        }
      ]
    },
    {
      "id": 3,
      "title": "P95 request latency (seconds)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, path))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "P95 model inference latency (seconds)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(prediction_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 inference latency"
        }
      ]
    },
    {
      "id": 5,
      "title": "Predicted class distribution",
      "type": "piechart",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "description": "A sudden shift here (e.g. the cancer-class rate jumping) is an early signal of data or prediction drift, since it needs no ground-truth labels to compute.",
      "targets": [
        {
          "expr": "sum by (label) (predictions_total)",
          "legendFormat": "{{label}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Total predictions served",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "targets": [{ "expr": "sum(predictions_total)" }]
    },
    {
      "id": 7,
      "title": "Total requests served",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "targets": [{ "expr": "sum(http_requests_total)" }]
    }
  ]
}
